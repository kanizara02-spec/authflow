{
  "name": "authflow",
  "private": true,
  "version": "1.0.0",
  "description": "Secure authentication & 2FA platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:demo": "npm run dev -w apps/demo-app",
    "build": "npm run build -w packages/security && npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/web",
    "start:api": "node apps/api/dist/index.js",
    "start:web": "npx vite preview --workspace=@authflow/web --port $PORT --host 0.0.0.0",
    "test": "npm run test -w apps/api",
    "lint": "npm run lint -w apps/api && npm run lint -w apps/web",
    "prisma:migrate": "npm run prisma:migrate -w apps/api",
    "prisma:seed": "npm run prisma:seed -w apps/api",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^5.5.4"
  }
}
