# ---------- General ----------
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
DEMO_APP_URL=http://localhost:5174

# ---------- Database ----------
DATABASE_URL=postgresql://authflow:authflow@localhost:5432/authflow?schema=public

# ---------- Redis (rate limiting, token blacklist) ----------
REDIS_URL=redis://localhost:6379

# ---------- JWT / Session secrets (generate with: openssl rand -base64 48) ----------
JWT_ACCESS_SECRET=replace-with-a-64-byte-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-byte-random-secret
JWT_ISSUER=authflow
JWT_AUDIENCE=authflow-clients
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ---------- TOTP secret encryption (AES-256-GCM key, 32 bytes base64) ----------
# generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
TOTP_ENCRYPTION_KEY_VERSION=1

# ---------- Email (MailHog locally, real SMTP in prod) ----------
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="AuthFlow Security <security@authflow.local>"

# ---------- Cookies ----------
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---------- Admin seed ----------
SEED_ADMIN_EMAIL=admin@authflow.local
SEED_ADMIN_PASSWORD=ChangeMe!12345
